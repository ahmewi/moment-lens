# MomentLens API: settings for LOCAL DEVELOPMENT. Copy this file to api/.env (git-ignored) and fill in the blanks.
#
# There are no keys, passwords or connection strings anywhere in MomentLens. Every Azure call uses Microsoft Entra ID:
# in Azure the web app's user-assigned managed identity, locally your `az login` identity (DefaultAzureCredential).
# The values below come from the deployment outputs (see docs/deployment.md); defaults are shown where they exist.
# Deployed apps get the same settings as App Service application settings from infra/ - not from a file.

# --- Azure context
AZURE_SUBSCRIPTION_ID=
AZURE_LOCATION=westeurope
# Client id of the user-assigned managed identity. Leave empty locally so that `az login` is used.
AZURE_CLIENT_ID=

# --- Storage (containers: videos, insights, thumbnails; job state goes to the Table below)
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_VIDEOS_CONTAINER=videos
AZURE_STORAGE_INSIGHTS_CONTAINER=insights
AZURE_STORAGE_THUMBNAILS_CONTAINER=thumbnails
JOBS_TABLE_ENABLED=true
JOBS_TABLE_NAME=momentlensjobs

# --- Azure AI Search (the API creates the index itself)
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=moments

# --- Azure OpenAI: deployment names (not model names). The embedding model must produce 3072-dimension vectors
# (text-embedding-3-large) because the search index is created with that size.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=chat
# Only for a reasoning-style chat model: low | medium | high (empty = classic temperature / max_tokens parameters).
AZURE_OPENAI_CHAT_REASONING_EFFORT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=embedding
# Stronger vision-capable model used as the judge (empty = reuse the chat deployment).
AZURE_OPENAI_JUDGE_DEPLOYMENT=judge
# Only for a reasoning-style judge: low | medium | high (empty = classic temperature / max_tokens parameters).
AZURE_OPENAI_JUDGE_REASONING_EFFORT=
# Optional: judge on another Azure OpenAI account or API version.
AZURE_OPENAI_JUDGE_ENDPOINT=
AZURE_OPENAI_JUDGE_API_VERSION=

# --- Azure AI Video Indexer (ARM-based account)
AZURE_VIDEO_INDEXER_ACCOUNT_ID=
AZURE_VIDEO_INDEXER_ACCOUNT_NAME=
AZURE_VIDEO_INDEXER_LOCATION=westeurope
AZURE_VIDEO_INDEXER_RESOURCE_GROUP=rg-momentlens
AZURE_VIDEO_INDEXER_API_VERSION=2024-01-01

# --- vi-poller Container Apps job. VI_POLLER_USE_JOB=false polls inside the API process instead (local development;
# the poll is lost if the process restarts).
VI_POLLER_USE_JOB=true
VI_POLLER_RESOURCE_GROUP=rg-momentlens
VI_POLLER_JOB_NAME=
VI_POLLER_TIMEOUT_MINUTES=240

# --- Upload limits
MAX_UPLOAD_MB=500
MAX_UPLOAD_MINUTES=30

# --- Search-time judge (rerank) and deep search
SEARCH_ACTION_RERANK_ENABLED=true
SEARCH_ACTION_RERANK_MAX_CANDIDATES=40
SEARCH_VISUAL_RERANK_ENABLED=true
SEARCH_VISUAL_RERANK_MAX_CANDIDATES=6
SEARCH_DEEP_MERGE_WINDOW_SECONDS=60

# --- Index-time visual enrichment and event analysis
VISUAL_ENRICH_ENABLED=true
VISUAL_ENRICH_MAX_CARDS=600
VISUAL_ENRICH_MAX_FRAMES=12
EVENT_ANALYSIS_MAX_SCENES=120
EVENT_ANALYSIS_BATCH_SIZE=12
EVENT_ANALYSIS_CONCURRENCY=4

# --- Telemetry. The connection string is injected by infra/ in Azure; leave it empty locally to disable telemetry.
APPLICATIONINSIGHTS_CONNECTION_STRING=
# Illustrative rates (USD) for the cost-per-run estimate on the workbook: set your own.
COST_RATE_VI_PER_MINUTE=0.04
COST_RATE_EMBEDDING_PER_MILLION_TOKENS=0.13

# --- Misc
DEBUG=false
